  "words": [
    {
      "display": "import express from 'express';\nconst app = express();",
      "input": "import express from 'express'; const app=express();",
      "annotation": "Express 5 / TypeScript：対象環境（Node.jsとExpress 5、@types/express等の型・TS実行設定が必要。各例は独立した断片）",
      "input_type": "code"
    },
    {
      "display": "app.get('/health', (_req, res) => {\n  res.json({ ok: true })\n});",
      "input": "app.get('/health',(_req,res)=>{res.json({ok:true})});",
      "annotation": "app.get：GETルート",
      "input_type": "code"
    },
    {
      "display": "app.post('/users', (_req, res) => {\n  res.status(201).json({ id: 1 })\n});",
      "input": "app.post('/users',(_req,res)=>{res.status(201).json({id:1})});",
      "annotation": "app.post / put / patch / delete：HTTPメソッド別ルート（例はDB保存しない。更新・削除時は入力検証・認証認可）",
      "input_type": "code"
    },
    {
      "display": "app.use(express.json({ limit: '100kb' }));",
      "input": "app.use(express.json({limit:'100kb'}));",
      "annotation": "express.json：JSON解析ミドルウェア（ルートより前に登録。未検証入力）",
      "input_type": "code"
    },
    {
      "display": "app.use(express.urlencoded({ extended: false, limit: '100kb' }));",
      "input": "app.use(express.urlencoded({extended:false,limit:'100kb'}));",
      "annotation": "express.urlencoded：フォーム解析（multipartファイル送信は別ライブラリ等）",
      "input_type": "code"
    },
    {
      "display": "app.delete('/sample', (_req, res) => {\n  res.status(204).end()\n});",
      "input": "app.delete('/sample',(_req,res)=>{res.status(204).end()});",
      "annotation": "res.sendStatus / end：定型・本文なし応答（実削除するなら認可・DB処理を追加）",
      "input_type": "code"
    },
    {
      "display": "app.post('/done', (_req, res) => {\n  res.redirect(303, '/success')\n});",
      "input": "app.post('/done',(_req,res)=>{res.redirect(303,'/success')});",
      "annotation": "res.redirect：転送（外部入力URLをそのまま使わない。自動returnではない）",
      "input_type": "code"
    },
    {
      "display": "app.use('/static', express.static('public'));",
      "input": "app.use('/static',express.static('public'));",
      "annotation": "express.static：静的配信（公開ディレクトリに秘密ファイルを置かない。相対パスはcwd依存）",
      "input_type": "code"
    },
    {
      "display": "import helmet from 'helmet';\napp.use(helmet());",
      "input": "import helmet from 'helmet'; app.use(helmet());",
      "annotation": "helmet：セキュリティヘッダー（別パッケージ。CSP等はアプリに合わせて調整）",
      "input_type": "code"
    },
    {
      "display": "npm install express",
      "input": "npm install express",
      "annotation": "実行：パッケージ・起動（ターミナル。型検査はtsc等で別途）",
      "input_type": "command"
    },
