      "input_type": "command"
    },
    {
      "display": "npx jest --coverage",
      "input": "npx jest --coverage",
      "annotation": "--watch / --coverage：監視実行・カバレッジ（カバレッジ率だけでテストの質は判断しない）",
      "input_type": "command"
    },
    {
      "display": "npx jest --runInBand",
      "input": "npx jest --runInBand",
      "annotation": "--runInBand / -t：直列実行・名前で絞る",
      "input_type": "command"
    },
    {
      "display": "npx jest -t '足し算'",
      "input": "npx jest -t '足し算'",
